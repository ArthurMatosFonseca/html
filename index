        function updateClock(delta) {
            if (!gameState.started || gameState.gameOver || gameState.socialistGovernment || gameState.dialogueOpen || gameState.cutsceneActive) return;

            gameState.elapsedMinutes += delta * 0.4;
            if (gameState.elapsedMinutes >= gameState.maxDayMinutes) {
                gameState.gameOver = true;
                document.getElementById('gameover-screen').classList.remove('hidden');
                return;
            }

            const totalMins = Math.floor(360 + gameState.elapsedMinutes);
            const hour = Math.floor(totalMins / 60) % 24;
            const min = totalMins % 60;
            const remHours = Math.max(0, Math.ceil((gameState.maxDayMinutes - gameState.elapsedMinutes) / 60));

            const clockStr = `${String(hour).padStart(2, '0')}:${String(min).padStart(2, '0')}`;
            if (clockStr !== lastClockText) {
                lastClockText = clockStr;
                document.getElementById('clock-time').innerText = clockStr;
                document.getElementById('clock-remaining').innerText = `(Restam ${remHours}h)`;
            }

            const progress = gameState.elapsedMinutes / gameState.maxDayMinutes;
            const sunFactor = Math.max(0.28, Math.sin(progress * Math.PI));
            dirLight.intensity = 0.35 + sunFactor * 0.75;
            ambientLight.intensity = 0.45 + sunFactor * 0.35;
            scene.background.setRGB(0.08 + sunFactor * 0.14, 0.10 + sunFactor * 0.16, 0.14 + sunFactor * 0.20);
            scene.fog.color.copy(scene.background);
        }

