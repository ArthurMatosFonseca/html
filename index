        function getCardboardTextures() {
            if (cardboardTextures.length > 0) return cardboardTextures;
            const slogans = [
                ["GREVE", "GERAL!"],
                ["PÃO E", "DIREITOS!"],
                ["PODER", "AO POVO!"],
                ["JORNADA", "DE 8H!"],
                ["FIM DA", "MISÉRIA!"],
                ["UNIÃO", "OPERÁRIA!"]
            ];
            slogans.forEach(([line1, line2]) => {
                const c = document.createElement('canvas');
                c.width = 128;
                c.height = 96;
                const ctx = c.getContext('2d');
                ctx.fillStyle = '#b08968';
                ctx.fillRect(0, 0, 128, 96);
                ctx.strokeStyle = '#7f5539';
                ctx.lineWidth = 4;
                ctx.strokeRect(3, 3, 122, 90);
                ctx.fillStyle = 'rgba(127, 85, 57, 0.22)';
                for (let y = 10; y < 90; y += 8) {
                    ctx.fillRect(6, y, 116, 2);
                }
                ctx.fillStyle = '#1c1917';
                ctx.font = 'bold 21px sans-serif';
                ctx.textAlign = 'center';
                ctx.fillText(line1, 64, 42);
                ctx.fillStyle = '#991b1b';
                ctx.fillText(line2, 64, 70);

                const tex = new THREE.CanvasTexture(c);
                cardboardTextures.push(tex);
            });
            return cardboardTextures;
        }

        function attachCardboardSign(rig) {
            if (!rig || rig.hasCardboardSign) return;
            rig.hasCardboardSign = true;

            if (!sharedGeo.signStick) {
                sharedGeo.signStick = new THREE.CylinderGeometry(0.035, 0.035, 1.55, 6);
                sharedGeo.signBoard = new THREE.BoxGeometry(0.95, 0.68, 0.05);
                sharedMat.signStick = new THREE.MeshStandardMaterial({ color: 0x5c4033, roughness: 0.9 });
            }

            const textures = getCardboardTextures();
            const texIdx = Math.floor(Math.random() * textures.length);
            const signMat = getCachedMat(`cardboard_sign_${texIdx}`, () => new THREE.MeshStandardMaterial({
                map: textures[texIdx],
                roughness: 0.92
            }));

            const signGroup = new THREE.Group();
            const stick = new THREE.Mesh(sharedGeo.signStick, sharedMat.signStick);
            stick.position.y = 0.35;
            signGroup.add(stick);

            const board = new THREE.Mesh(sharedGeo.signBoard, signMat);
            board.position.y = 1.05;
            signGroup.add(board);

            signGroup.position.set(0, -0.78, 0.08);
            signGroup.rotation.x = 2.35;
            rig.rightArm.add(signGroup);
            rig.rightArm.rotation.x = -2.35;
            rig.leftArm.rotation.x = 0;
            rig.leftLeg.rotation.x = 0;
            rig.rightLeg.rotation.x = 0;
            rig.signGroup = signGroup;
        }

        function getPrefectureProtestPosition(index) {
            const row = Math.floor(index / 20);
            const colInRow = index % 20;
            const side = colInRow % 2 === 0 ? -1 : 1;
            const colOffset = Math.floor(colInRow / 2);

            let px = side * (3.2 + colOffset * 2.35);
            let pz = -62.5 - row * 1.95;

            if (Math.hypot(px, pz + 68) < 5.0) {
                px += side * 4.8;
            }
            if (px > -12.2 && px < -4.8 && pz > -79.2 && pz < -73.8) {
                pz -= 5.8;
            }
            return new THREE.Vector3(px, 0, pz);
        }

        function markCitizenConvinced(citizenObj) {
            if (!citizenObj || citizenObj.convinced) return;
            citizenObj.convinced = true;

            if (citizenObj.rig.convincedMarker) {
                citizenObj.rig.convincedMarker.visible = true;
            }

            citizenObj.rig.group.rotation.x = 0;
            citizenObj.rig.group.position.y = 0;
            if (citizenObj.walker) {
                citizenObj.walker.paused = true;
            }

            attachCardboardSign(citizenObj.rig);
            const protestPos = getPrefectureProtestPosition(protestingCitizens.length);
            citizenObj.protestPos = protestPos;
            citizenObj.protestPhase = Math.random() * Math.PI * 2;
            citizenObj.rig.group.position.copy(protestPos);
            citizenObj.rig.group.rotation.y = Math.PI + (Math.random() - 0.5) * 0.25;
            protestingCitizens.push(citizenObj);

            gameState.citizensConvinced = Math.min(gameState.totalCitizens, gameState.citizensConvinced + 1);
        }

        function recruitCitizensForFactoryProtest(count = 25) {
            let recruited = 0;
            for (let i = 0; i < allCitizens.length && recruited < count; i++) {
                const c = allCitizens[i];
                if (!c.convinced) {
                    markCitizenConvinced(c);
                    recruited++;
                }
            }
            return recruited;
        }

        function convinceCitizenAndListeners(citizenObj) {
            let groupCount = 0;
            if (!citizenObj.convinced) {
                markCitizenConvinced(citizenObj);
                groupCount++;
            }
            allCitizens.forEach(other => {
                if (groupCount >= 3) return;
                if (!other.convinced && other !== citizenObj && other.group.position.distanceTo(citizenObj.group.position) <= 7.5) {
                    if (gameState.refusalChance === 0 || Math.random() >= gameState.refusalChance) {
                        markCitizenConvinced(other);
                        groupCount++;
                    }
                }
            });
            if (groupCount > 0) {
                increaseConsciousness(Math.min(6, groupCount * 2));
                updateMissionUI();
            }
            return groupCount;
        }

