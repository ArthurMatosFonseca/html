                [-52, 72], [-36, 72], [-20, 72], [-4, 72], [12, 72], [26, 72],
                [-65, 24], [-65, 10], [-65, -10], [-65, -24], [-38, 10], [-38, -10],
                [-12, -12], [-8, -14], [-18, -16], [8, -12], [14, -12], [22, -8],
                [36, 36], [36, 20], [36, 5], [36, -15], [36, -35], [36, -50],
                [48, 46], [58, 46], [48, 62], [-2, -32], [4, -32], [-32, -32]
            ];

            let idx = 0;
            while (allCitizens.length < targetTotal) {
                const hub = streetHubs[idx % streetHubs.length];
                let cx = hub[0];
                let cz = hub[1];

                for (let attempt = 0; attempt < 12; attempt++) {
                    const angle = ((idx + attempt) * 2.39996) % (Math.PI * 2);
                    const radius = 0.8 + ((idx + attempt) % 5) * 0.95;
                    const tx = hub[0] + Math.cos(angle) * radius;
                    const tz = hub[1] + Math.sin(angle) * radius;
                    if (!checkCitizenCollision(tx, tz)) {
                        cx = tx;
                        cz = tz;
                        break;
                    }
                }

                const rCfg = roles[idx % roles.length];
                const personName = `${rCfg.role.split(' ')[0]} ${firstNames[idx % firstNames.length]}`;
                const pair = dialoguePairs[idx % dialoguePairs.length];

                let waypoints = null;
                if (idx % 2 === 0) {
                    const nextHub = streetHubs[(idx + 1) % streetHubs.length];
                    if (Math.hypot(nextHub[0] - cx, nextHub[1] - cz) < 26 && !checkCitizenCollision(nextHub[0], nextHub[1])) {
                        waypoints = [
                            new THREE.Vector3(cx, 0, cz),
                            new THREE.Vector3(nextHub[0], 0, nextHub[1])
                        ];
                    }
                }

                createCitizenNPC(
                    cx,
                    cz,
                    {
                        shirtColor: rCfg.shirt,
                        hatType: rCfg.hat,
                        hasApron: rCfg.apron,
                        ragged: rCfg.role.includes("Desabrigado")
                    },
                    personName,
                    rCfg.role,
                    rCfg.avatar,
                    pair.doubt,
                    pair.arg,
                    waypoints
                );
                idx++;
            }
        }

