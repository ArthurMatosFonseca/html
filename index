                new THREE.SphereGeometry(0.75, 14, 10),
                new THREE.MeshStandardMaterial({ color: 0xfbbf24, metalness: 0.85, roughness: 0.2, emissive: 0xb45309, emissiveIntensity: 0.35 })
            );
            goldMound.scale.set(1.1, 0.55, 0.75);
            goldMound.position.y = 0.92;
            cutsceneTreasuryGroup.add(goldMound);
            scene.add(cutsceneTreasuryGroup);

            const crowdSubset = allCitizens.slice(0, 18);
            crowdSubset.forEach((c, i) => {
                const t = (i / (crowdSubset.length - 1)) - 0.5;
                const angle = t * Math.PI * 0.85;
                const dist = 5.2 + (i % 2) * 1.4;
                const tx = Math.sin(angle) * dist;
                const tz = -72 + Math.cos(angle) * dist;

                c.rig.group.position.set(tx, 0, tz);
                c.rig.group.rotation.y = Math.atan2(-tx, -72 - tz);
                if (c.rig.convincedMarker) c.rig.convincedMarker.visible = true;
                cutsceneActors.push({
                    rig: c.rig,
                    basePos: new THREE.Vector3(tx, 0, tz),
                    phase: i * 0.7,
                    receivedMoney: false
                });
            });
        }

        function spawnCutsceneMoneyBag(fromPos, toPos) {
            const bag = new THREE.Mesh(
                new THREE.SphereGeometry(0.24, 10, 10),
                new THREE.MeshStandardMaterial({ color: 0xfbbf24, metalness: 0.8, roughness: 0.2, emissive: 0xd97706, emissiveIntensity: 0.5 })
            );
            bag.position.copy(fromPos);
            bag.position.y += 1.4;
            scene.add(bag);
            cutsceneCoins.push({
                mesh: bag,
                start: bag.position.clone(),
                end: new THREE.Vector3(toPos.x, 1.35, toPos.z),
                progress: 0
            });
        }

        function updateCutscene(delta, time) {
            gameState.cutsceneTimer += delta;
            const t = gameState.cutsceneTimer;
            const subtitleEl = document.getElementById('cutscene-subtitle');

            if (t < 4.5) {
                if (gameState.endingType === 'election') {
                    subtitleEl.innerText = "Eleito pelo povo no palanque da Prefeitura! Os cofres públicos foram abertos diante dos moradores...";
                } else if (gameState.endingType === 'surrender') {
                    subtitleEl.innerText = "Diante das 3 revoltas fabris, o governo desistiu de detê-lo e entregou as chaves do Tesouro...";
                } else {
                    subtitleEl.innerText = "O povo se revoltou e derrubou o governo burguês! Os cofres do Palácio foram abertos diante dos moradores...";
                }
            } else if (t < 9.5) {
                subtitleEl.innerText = "Você entrega o dinheiro acumulado das fábricas e monopólios diretamente nas mãos dos trabalhadores e famílias!";
            } else {
                subtitleEl.innerText = "Ninguém mais dormirá na rua ou passará fome. Nasce a República Socialista dos Trabalhadores!";
            }

            const sweep = Math.sin(t * 1.35);
            playerGroup.position.x = sweep * 2.8;
            playerGroup.position.z = -71.5 + Math.cos(t * 1.35) * 0.8;
            playerGroup.rotation.y = sweep * 0.45;

            leftArm.rotation.x = -0.8 + Math.sin(t * 8) * 0.45;
            rightArm.rotation.x = -0.8 - Math.sin(t * 8) * 0.45;
            leftLeg.rotation.x = Math.sin(t * 6) * 0.25;
            rightLeg.rotation.x = -Math.sin(t * 6) * 0.25;

            const actorIdx = Math.floor(t * 1.6) % cutsceneActors.length;
            const targetActor = cutsceneActors[actorIdx];
            if (targetActor && !targetActor.receivedMoney) {
                targetActor.receivedMoney = true;
                spawnCutsceneMoneyBag(playerGroup.position, targetActor.basePos);
            }

            for (let i = cutsceneCoins.length - 1; i >= 0; i--) {
                const coin = cutsceneCoins[i];
                coin.progress += delta * 1.6;
                if (coin.progress >= 1) {
                    scene.remove(coin.mesh);
                    cutsceneCoins.splice(i, 1);
                } else {
                    coin.mesh.position.lerpVectors(coin.start, coin.end, coin.progress);
                    coin.mesh.position.y += Math.sin(coin.progress * Math.PI) * 1.4;
                    coin.mesh.rotation.y += delta * 6;
                }
            }

            cutsceneActors.forEach(a => {
                const jump = Math.abs(Math.sin(time * 5 + a.phase)) * 0.25;
                a.rig.group.position.y = jump;
                a.rig.leftArm.rotation.x = -2.4 + Math.sin(time * 7 + a.phase) * 0.35;
                if (!a.rig.hasCardboardSign) {
                    a.rig.rightArm.rotation.x = -2.4 - Math.sin(time * 7 + a.phase) * 0.35;
                }
            });

            const camOrbit = Math.sin(t * 0.42) * 0.65;
            camera.position.set(
                Math.sin(camOrbit) * 9.5,
                4.2,
                -72 + Math.cos(camOrbit) * 9.5
            );
            camera.lookAt(0, 1.6, -70.5);

            if (t >= 13.5) {
                window.finishCutscene();
            }
        }

        window.finishCutscene = function() {
