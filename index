        // --- GERADOR DE TEXTURAS PROCEDURAIS ---
        function createProceduralTexture(baseColor, lineColor, patternType) {
            const canvas = document.createElement('canvas');
            canvas.width = 256;
            canvas.height = 256;
            const ctx = canvas.getContext('2d');

            ctx.fillStyle = baseColor;
            ctx.fillRect(0, 0, 256, 256);

            if (patternType === 'bricks') {
                ctx.fillStyle = lineColor;
                for (let y = 0; y < 256; y += 32) {
                    ctx.fillRect(0, y, 256, 3);
                    const offset = (y / 32) % 2 === 0 ? 0 : 32;
                    for (let x = offset; x < 256; x += 64) {
                        ctx.fillRect(x, y, 3, 32);
                    }
                }
            } else if (patternType === 'cobble') {
                ctx.strokeStyle = lineColor;
                ctx.lineWidth = 2;
                for (let y = 0; y < 256; y += 32) {
                    for (let x = 0; x < 256; x += 32) {
                        ctx.strokeRect(x + ((y / 32) % 2) * 8, y, 28, 28);
                    }
                }
            } else if (patternType === 'marble') {
                ctx.strokeStyle = lineColor;
                ctx.lineWidth = 1.5;
                for (let i = 0; i < 14; i++) {
                    ctx.beginPath();
                    ctx.moveTo(Math.random() * 256, 0);
                    ctx.bezierCurveTo(Math.random() * 256, 85, Math.random() * 256, 170, Math.random() * 256, 256);
                    ctx.stroke();
                }
            }

            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }

