                sharedGeo.checkShort = new THREE.BoxGeometry(0.11, 0.28, 0.11);
                sharedGeo.checkLong = new THREE.BoxGeometry(0.11, 0.54, 0.11);
                sharedGeo.checkHalo = new THREE.TorusGeometry(0.32, 0.035, 6, 18);

                sharedMat.charEye = new THREE.MeshBasicMaterial({ color: 0x111111 });
                sharedMat.charPatch = new THREE.MeshStandardMaterial({ color: 0x78716c, roughness: 0.95 });
                sharedMat.charApron = new THREE.MeshStandardMaterial({ color: 0x57534e, roughness: 0.95 });
                sharedMat.charScarf = new THREE.MeshStandardMaterial({ color: 0xdc2626 });
                sharedMat.checkGreen = new THREE.MeshBasicMaterial({ color: 0x22c55e });
                sharedMat.checkHalo = new THREE.MeshBasicMaterial({ color: 0x86efac });
            }

            const {
                shirtColor = 0x3b4252,
                pantsColor = 0x242933,
                skinColor = 0xd6a384,
                hatType = 'cap',
                hatColor = 0x1f2937,
                hasApron = false,
                ragged = false,
                pose = 'standing',
                isCitizen = false
            } = options;

            const charGroup = new THREE.Group();
            const skinMat = getCachedMat(`skin_${skinColor}`, () => new THREE.MeshStandardMaterial({ color: skinColor, roughness: 0.65 }));
            const shirtMat = getCachedMat(`shirt_${shirtColor}_${ragged}`, () => new THREE.MeshStandardMaterial({ color: shirtColor, roughness: ragged ? 0.98 : 0.8 }));
            const pantsMat = getCachedMat(`pants_${pantsColor}_${ragged}`, () => new THREE.MeshStandardMaterial({ color: pantsColor, roughness: ragged ? 0.98 : 0.85 }));
            const shoeMat = getCachedMat(`shoe_${ragged}`, () => new THREE.MeshStandardMaterial({ color: ragged ? 0x57534e : 0x18181b, roughness: 0.8 }));

            const torso = new THREE.Mesh(sharedGeo.charTorso, shirtMat);
            torso.position.y = 1.42;
            charGroup.add(torso);

            if (ragged) {
                const patch = new THREE.Mesh(sharedGeo.charPatch, sharedMat.charPatch);
                patch.position.set(0.2, 1.35, 0);
                charGroup.add(patch);
            }

            if (hasApron) {
                const apron = new THREE.Mesh(sharedGeo.charApron, sharedMat.charApron);
                apron.position.y = 1.25;
                charGroup.add(apron);
            }

            const head = new THREE.Mesh(sharedGeo.charHead, skinMat);
            head.position.y = 2.34;
            charGroup.add(head);

            [-0.12, 0.12].forEach(ex => {
                const eye = new THREE.Mesh(sharedGeo.charEye, sharedMat.charEye);
                eye.position.set(ex, 2.38, 0.32);
                charGroup.add(eye);
            });

            const hatMat = getCachedMat(`hat_${hatColor}`, () => new THREE.MeshStandardMaterial({ color: hatColor, roughness: 0.7 }));
            if (hatType === 'cap') {
                const capCrown = new THREE.Mesh(sharedGeo.charCapCrown, hatMat);
                capCrown.position.y = 2.66;
                charGroup.add(capCrown);
                const visor = new THREE.Mesh(sharedGeo.charCapVisor, hatMat);
                visor.position.set(0, 2.58, 0.28);
                charGroup.add(visor);
            } else if (hatType === 'tophat') {
                const brim = new THREE.Mesh(sharedGeo.charTophatBrim, hatMat);
                brim.position.y = 2.62;
                charGroup.add(brim);
                const top = new THREE.Mesh(sharedGeo.charTophatTop, hatMat);
                top.position.y = 2.95;
                charGroup.add(top);
            } else if (hatType === 'scarf') {
                const scarf = new THREE.Mesh(sharedGeo.charScarf, sharedMat.charScarf);
                scarf.rotation.x = Math.PI / 2;
                scarf.position.y = 2.02;
