        window.rallyNearbyCitizens = function() {
            if (!gameState.started || gameState.dialogueOpen || gameState.gameOver || gameState.cutsceneActive || !playerGroup) return;
            if (gameState.consciousness < 20) {
                window.openDialogue(
                    "Discurso nas Ruas",
                    "Agitação Popular",
                    "📢",
                    "Sua consciência teórica ainda é baixa para convencer multidões de uma vez! Converse individualmente com alguns moradores primeiro ou colete um volume de O Capital.",
                    [{ text: "Vou dialogar com os moradores", action: window.closeDialogue }],
                    false
                );
                return;
            }
            let newlyConvinced = 0;
            let refusedCount = 0;
            allCitizens.forEach(c => {
                if (newlyConvinced >= 4) return;
                if (!c.convinced && c.group.position.distanceTo(playerGroup.position) <= 12) {
                    if (gameState.refusalChance > 0 && Math.random() < gameState.refusalChance) {
                        refusedCount++;
                    } else {
                        markCitizenConvinced(c);
                        newlyConvinced++;
                    }
                }
            });
            if (newlyConvinced > 0) {
                increaseConsciousness(Math.min(8, newlyConvinced * 2));
                updateMissionUI();
                const refusalText = refusedCount > 0 ? ` (${refusedCount} pessoa(s) ficaram receosas e recusaram no modo Difícil).` : "";
                window.openDialogue(
                    "Discurso Revolucionário nas Ruas!",
                    "Agitação Popular",
                    "📢",
                    `Você ergueu a voz explicando a exploração do trabalho! ${newlyConvinced} morador(es) pegaram seus cartazes de papelão e foram protestar na frente da Prefeitura! (${gameState.citizensConvinced}/${gameState.requiredCitizens})${refusalText}`,
                    [{ text: "Avante, camaradas!", action: window.closeDialogue }],
                    false
                );
            } else if (refusedCount > 0) {
                window.openDialogue(
                    "Discurso nas Ruas (Resistência)",
                    "Dificuldade Difícil",
                    "😟",
                    `Os ${refusedCount} moradores próximos ficaram com medo da guarda e recusaram se juntar agora (50% de chance no modo Difícil). Tente novamente ou converse com outros cidadãos!`,
                    [{ text: "Continuar insistindo!", action: window.closeDialogue }],
                    false
                );
            } else {
                window.openDialogue(
                    "Discurso nas Ruas",
                    "Agitação Popular",
                    "📢",
                    "Não há moradores ainda não convencidos num raio de 12 metros. Caminhe até outros bairros ou converse diretamente com os cidadãos!",
                    [{ text: "Continuar explorando", action: window.closeDialogue }],
                    false
                );
            }
        };

        window.openDialogue = function(name, role, avatar, text, buttons = [], allowTyping = true, citizenTarget = null) {
            gameState.dialogueOpen = true;
            gameState.currentSpeaker = { name, role, avatar, initialText: text };
            gameState.currentCitizenTarget = citizenTarget;
            gameState.chatHistory = [];

            document.getElementById('speaker-name').innerText = name;
            document.getElementById('speaker-role').innerText = role;
            document.getElementById('speaker-avatar').innerText = avatar;
            document.getElementById('dialogue-text').innerText = text;

            const historyEl = document.getElementById('typed-chat-history');
            historyEl.innerHTML = '';

            const formEl = document.getElementById('typed-chat-form');
            const badgeEl = document.getElementById('dialogue-mode-badge');
            const inputEl = document.getElementById('typed-chat-input');

            if (gameState.dialogueMode === 'typed' && allowTyping) {
                formEl.classList.remove('hidden');
                badgeEl.innerText = '⌨️ Conversa Digitada';
                badgeEl.className = 'text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-950 text-amber-300 border border-amber-500/50';
                inputEl.value = '';
                setTimeout(() => inputEl.focus(), 60);
            } else {
                formEl.classList.add('hidden');
                badgeEl.innerText = '⚡ Diálogo Rápido';
                badgeEl.className = 'text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-stone-800 text-stone-300 border border-stone-700';
            }

            const btnContainer = document.getElementById('dialogue-buttons');
            btnContainer.innerHTML = '';

            if (buttons.length === 0) {
                buttons = [{ text: "Entendido", action: window.closeDialogue }];
