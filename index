                label: label,
                onInteract: () => {
                    if (!playerGroup) return;
                    savedOutdoorPos.copy(playerGroup.position);
                    currentInterior = interiorId;
                    playerGroup.position.copy(spawnPos);
                    playerGroup.rotation.y = Math.PI;
                    cameraAngle = 0;
                    cameraPitch = 0.28;
                    setActiveInteriorLight(interiorId);
                    updateZoneIndicator(spawnPos.x, spawnPos.z);
                }
            });
        }

        function createInteriorRoom(cx, cz, w, d, h, floorColor, wallColor, lightColor, interiorId, exitZ) {
            const room = new THREE.Group();
            room.position.set(cx, 0, cz);

            interiorBounds[interiorId] = {
                minX: cx - w / 2,
                maxX: cx + w / 2,
                minZ: cz - d / 2,
                maxZ: cz + d / 2,
                height: h
            };

            const floor = new THREE.Mesh(
                new THREE.PlaneGeometry(w, d),
                new THREE.MeshStandardMaterial({ color: floorColor, roughness: 0.85 })
            );
            floor.rotation.x = -Math.PI / 2;
            room.add(floor);

            const ceiling = new THREE.Mesh(
                new THREE.PlaneGeometry(w, d),
                new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.9 })
            );
            ceiling.rotation.x = Math.PI / 2;
            ceiling.position.y = h;
            room.add(ceiling);

            const wallMat = new THREE.MeshStandardMaterial({ color: wallColor, roughness: 0.85 });

            const backWall = new THREE.Mesh(new THREE.PlaneGeometry(w, h), wallMat);
            backWall.position.set(0, h / 2, -d / 2);
            room.add(backWall);

            const frontWall = new THREE.Mesh(new THREE.PlaneGeometry(w, h), wallMat);
            frontWall.position.set(0, h / 2, d / 2);
            frontWall.rotation.y = Math.PI;
            room.add(frontWall);

            const leftWall = new THREE.Mesh(new THREE.PlaneGeometry(d, h), wallMat);
            leftWall.position.set(-w / 2, h / 2, 0);
            leftWall.rotation.y = Math.PI / 2;
            room.add(leftWall);

            const rightWall = new THREE.Mesh(new THREE.PlaneGeometry(d, h), wallMat);
            rightWall.position.set(w / 2, h / 2, 0);
            rightWall.rotation.y = -Math.PI / 2;
            room.add(rightWall);

            const exitDoor = new THREE.Mesh(
                new THREE.BoxGeometry(1.6, 2.5, 0.2),
                new THREE.MeshStandardMaterial({ color: 0xb45309, emissive: 0x78350f })
            );
            exitDoor.position.set(0, 1.25, d / 2 - 0.12);
            room.add(exitDoor);

            const light = new THREE.PointLight(lightColor, 1.9, Math.max(w, d) * 1.8);
            light.position.set(0, h - 0.9, 0);
            light.visible = false;
            room.add(light);
            interiorLights[interiorId] = light;

            scene.add(room);

            const exitPad = new THREE.Mesh(
                new THREE.CylinderGeometry(1.1, 1.1, 0.08, 16),
                new THREE.MeshBasicMaterial({ color: 0x38bdf8, transparent: true, opacity: 0.6 })
            );
            exitPad.position.set(cx, 0.05, exitZ);
            scene.add(exitPad);

            interactables.push({
                mesh: exitPad,
                radius: 2.5,
                label: "Sair para a Rua",
                onInteract: () => {
                    currentInterior = null;
                    setActiveInteriorLight(null);
                    playerGroup.position.copy(savedOutdoorPos);
                    cameraPitch = 0.45;
                    updateZoneIndicator(playerGroup.position.x, playerGroup.position.z);
                }
            });

            return room;
        }

