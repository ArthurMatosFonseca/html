                    const hintNotice = document.createElement('div');
                    hintNotice.className = 'bg-amber-950/70 border border-amber-600/60 rounded-lg p-2 text-[11px] text-amber-200';
                    hintNotice.innerText = `💬 ${c.name} ainda está em dúvida. Fale sobre união dos trabalhadores, exploração nas fábricas ou distribuição da riqueza!`;
                    historyEl.appendChild(hintNotice);
                }
            }

            scrollArea.scrollTop = scrollArea.scrollHeight;
        };

