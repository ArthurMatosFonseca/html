                        const convNotice = document.createElement('div');
                        convNotice.className = 'bg-emerald-950/90 border border-emerald-500 rounded-lg p-2.5 text-xs text-emerald-200 font-semibold';
                        convNotice.innerText = newly > 1
                            ? `🪧 ${c.name} e mais ${newly - 1} vizinho(s) pegaram cartazes de papelão e foram protestar na frente da Prefeitura! (${gameState.citizensConvinced}/${gameState.requiredCitizens})`
                            : `🪧 ${c.name} pegou um cartaz de papelão e foi protestar na frente da Prefeitura! (${gameState.citizensConvinced}/${gameState.requiredCitizens})`;
                        historyEl.appendChild(convNotice);
