<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>A Engrenagem e a Bandeira — Mundo Aberto 3D</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js r128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Fontes Google -->
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            overflow: hidden;
            font-family: 'Inter', sans-serif;
            background-color: #111;
            user-select: none;
            -webkit-user-select: none;
        }
        .font-title {
            font-family: 'Cinzel', serif;
        }
        #game-canvas {
            display: block;
            width: 100vw;
            height: 100vh;
            touch-action: none;
        }
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(20, 20, 20, 0.8);
        }
        ::-webkit-scrollbar-thumb {
            background: #dc2626;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="text-stone-100">

    <!-- Canvas 3D Principal -->
    <canvas id="game-canvas"></canvas>

    <!-- HUD Superior Responsivo (Desktop e Mobile) -->
    <div id="hud-top" class="absolute top-0 left-0 w-full p-2 md:p-4 flex flex-col lg:flex-row justify-between items-stretch lg:items-start pointer-events-none gap-1.5 md:gap-2.5 z-20 pr-28 sm:pr-36 md:pr-4">
        <!-- Painel de Consciência de Classe + Local + Botão Controles Mobile -->
        <div class="bg-stone-900/90 border-l-4 border-red-600 p-2 md:p-3 rounded-r-lg shadow-xl backdrop-blur-sm pointer-events-auto lg:max-w-xs w-full">
            <div class="flex justify-between items-center mb-1 gap-2">
                <span class="text-[10px] md:text-xs font-bold uppercase tracking-wider text-red-400">Consciência</span>
                <span id="consciousness-pct" class="text-[10px] md:text-xs font-extrabold text-amber-400">10% (Alienado)</span>
            </div>
            <div class="w-full bg-stone-700 h-2 md:h-2.5 rounded-full overflow-hidden">
                <div id="consciousness-bar" class="bg-gradient-to-r from-amber-600 via-red-600 to-red-500 h-full transition-all duration-500" style="width: 10%"></div>
            </div>
            <div class="mt-1.5 flex flex-wrap justify-between items-center gap-1 text-[11px] md:text-xs text-stone-300">
                <span class="truncate">Local: <strong id="zone-name" class="text-white">Vila Operária</strong></span>
                <button type="button" onclick="window.toggleMobileControls()" class="pointer-events-auto px-2 py-0.5 rounded bg-stone-800 hover:bg-stone-700 border border-stone-600 text-[10px] font-bold text-amber-300 cursor-pointer">
                    📱 Controles
                </button>
            </div>
        </div>

        <!-- Relógio de 24 Horas (Prazo de 1 Dia) -->
        <div class="bg-stone-900/95 border-l-4 lg:border-l-0 lg:border-b-4 border-sky-500 px-2.5 py-1.5 md:px-4 md:py-2.5 rounded-lg shadow-xl backdrop-blur-sm pointer-events-auto flex items-center justify-between lg:justify-start gap-2 md:gap-3">
            <div class="flex items-center gap-2">
                <span class="text-lg md:text-2xl">🕰️</span>
                <div>
                    <div class="hidden md:block text-[10px] font-bold uppercase tracking-widest text-sky-400">Prazo da Revolta (1 Dia)</div>
                    <div class="flex items-baseline gap-1.5">
                        <span id="clock-time" class="font-title text-sm md:text-xl font-bold text-white">06:00</span>
                        <span id="clock-remaining" class="text-[10px] md:text-xs font-semibold text-amber-400">(Restam 24h)</span>
                    </div>
                </div>
            </div>
            <span id="mobile-mini-counter" class="lg:hidden text-[10px] font-bold text-amber-300">🪧 0/100 • 📕 0/3 • 🏭 0/3</span>
        </div>

        <!-- Painel de Objetivos / Missão Atual (Desktop) -->
        <div class="hidden lg:block bg-stone-900/90 border-r-4 border-amber-500 p-3 rounded-l-lg shadow-xl backdrop-blur-sm pointer-events-auto max-w-md w-full text-left">
            <div class="flex items-center justify-between gap-2 mb-1">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-400">3 Caminhos Para o Poder Popular</span>
                <span id="difficulty-hud-badge" class="text-[10px] font-extrabold uppercase px-2 py-0.5 rounded bg-amber-950 border border-amber-500/60 text-amber-300">Média</span>
            </div>
            <p id="mission-text" class="text-xs md:text-sm font-semibold text-white">Convença os moradores (cada fábrica leva +25 com papelão para protestar na Prefeitura), reúna O Capital e conquiste um dos 3 Finais!</p>
            <div id="mission-counter" class="text-xs text-amber-300 font-semibold mt-1">Protestando: 0 / 100 | O Capital: 0 / 3 | Fábricas: 0 / 3</div>
            <div id="election-status-badge" class="text-[11px] font-bold mt-1 text-sky-300">🗳️ Palanque da Prefeitura: 50% chance de vitória (mín. 35 apoiadores)</div>
        </div>
    </div>

    <!-- Indicador de Interação (Flutuante no centro inferior) -->
    <div id="interact-prompt" class="hidden absolute bottom-32 md:bottom-10 left-1/2 transform -translate-x-1/2 bg-red-700/95 text-white px-4 py-2 md:px-5 md:py-2.5 rounded-full font-bold text-xs md:text-sm shadow-2xl border border-red-400 animate-bounce pointer-events-auto cursor-pointer z-30 max-w-[90vw] truncate" onclick="window.triggerInteraction()">
        [E] ou Toque aqui para Interagir
    </div>

    <!-- Overlay Cinematográfico da Cutscene Final -->
    <div id="cutscene-overlay" class="hidden absolute inset-0 pointer-events-none z-40 flex flex-col justify-between">
        <div class="w-full h-16 md:h-20 bg-black/95 border-b border-amber-500/40 flex items-center justify-between px-6 pointer-events-auto">
            <span class="text-xs md:text-sm font-title tracking-widest text-amber-400 uppercase">★ Vitória Popular — Redistribuição da Riqueza ★</span>
            <button type="button" onclick="window.finishCutscene()" class="px-3.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-stone-200 text-xs font-bold rounded-lg border border-stone-600 cursor-pointer">
                Pular Cutscene ⏭
            </button>
        </div>
        <div class="w-full bg-gradient-to-t from-black via-black/95 to-transparent pt-8 pb-6 px-6 text-center">
            <p id="cutscene-subtitle" class="font-title text-base md:text-xl text-amber-300 max-w-3xl mx-auto drop-shadow-lg">
                O governo burguês caiu! Agora o tesouro acumulado nas fábricas e cofres públicos retorna às mãos dos moradores...
            </p>
        </div>
    </div>

    <!-- Modal de Animação de Contagem de Votos (Eleição na Prefeitura - Final 3) -->
    <div id="vote-counting-modal" class="hidden absolute inset-0 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 z-50">
        <div class="bg-stone-900 border-2 border-sky-500 rounded-2xl max-w-lg w-full p-6 md:p-7 shadow-2xl text-center">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-950 border border-sky-500/50 text-sky-300 text-xs font-bold uppercase tracking-wider mb-3">
                <span class="animate-spin">⚙️</span> Apuração Oficial das Urnas
            </div>
            <h3 class="font-title text-2xl md:text-3xl font-bold text-white mb-1">
                CONTAGEM DE VOTOS
            </h3>
            <p id="vote-difficulty-info" class="text-xs text-amber-300 font-semibold mb-5">
                Dificuldade Média • Chance de Vitória: 50%
            </p>

            <!-- Placar Animado dos Candidatos -->
            <div class="space-y-4 text-left bg-stone-950/90 p-4 rounded-xl border border-stone-800 mb-4">
                <div>
                    <div class="flex justify-between items-baseline mb-1">
                        <span class="text-sm font-extrabold text-red-400 flex items-center gap-1.5">🚩 Chapa Popular (Você)</span>
                        <span id="votes-player-count" class="font-title text-xl font-bold text-white">0 votos</span>
                    </div>
                    <div class="w-full h-4 bg-stone-800 rounded-full overflow-hidden border border-stone-700">
                        <div id="votes-player-bar" class="h-full bg-gradient-to-r from-red-600 to-amber-500 transition-all duration-150" style="width: 0%"></div>
                    </div>
                </div>

                <div>
                    <div class="flex justify-between items-baseline mb-1">
                        <span class="text-sm font-extrabold text-sky-400 flex items-center gap-1.5">🎩 Chapa do Capital</span>
                        <span id="votes-rival-count" class="font-title text-xl font-bold text-stone-300">0 votos</span>
                    </div>
                    <div class="w-full h-4 bg-stone-800 rounded-full overflow-hidden border border-stone-700">
                        <div id="votes-rival-bar" class="h-full bg-gradient-to-r from-slate-600 to-sky-600 transition-all duration-150" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Feed de Urnas Sendo Apuradas -->
            <div id="vote-urn-status" class="text-xs md:text-sm font-semibold text-amber-200 bg-stone-800/80 border border-stone-700 rounded-lg py-2.5 px-3 mb-4 min-h-[42px] flex items-center justify-center gap-2">
                <span>🗳️</span>
                <span id="vote-urn-text">Abrindo a primeira urna dos trabalhadores...</span>
            </div>

            <!-- Resultado Final da Apuração -->
            <div id="vote-result-box" class="hidden rounded-xl p-4 mb-4 border">
                <h4 id="vote-result-title" class="font-title text-xl font-bold mb-1"></h4>
                <p id="vote-result-desc" class="text-xs md:text-sm"></p>
            </div>

            <div id="vote-modal-actions" class="hidden flex justify-center">
                <button type="button" id="vote-continue-btn" class="px-6 py-3 bg-sky-600 hover:bg-sky-500 text-white font-extrabold rounded-xl uppercase tracking-wider shadow-lg cursor-pointer transition">
                    Continuar
                </button>
            </div>
        </div>
    </div>

    <!-- Caixa de Diálogo / Narrativa -->
    <div id="dialogue-box" class="hidden absolute inset-0 bg-black/65 backdrop-blur-xs flex items-end md:items-center justify-center p-3 md:p-4 z-40">
        <div class="bg-stone-900 border-2 border-stone-700 rounded-2xl max-w-2xl w-full p-5 md:p-6 shadow-2xl max-h-[88vh] flex flex-col">
            <div class="flex items-center justify-between gap-3 mb-3 border-b border-stone-800 pb-3">
                <div class="flex items-center gap-3">
                    <div id="speaker-avatar" class="w-11 h-11 md:w-12 md:h-12 rounded-full bg-red-900/60 border-2 border-red-500 flex items-center justify-center text-xl md:text-2xl shrink-0">
                        ⚒️
                    </div>
                    <div>
                        <h3 id="speaker-name" class="font-bold text-base md:text-lg text-amber-400">Operário</h3>
                        <span id="speaker-role" class="text-[11px] uppercase tracking-wider text-stone-400">Proletariado Urbano</span>
                    </div>
                </div>
                <span id="dialogue-mode-badge" class="text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-full bg-stone-800 text-stone-300 border border-stone-700">
                    Modo Rápido
                </span>
            </div>

            <!-- Histórico da Conversa -->
            <div id="dialogue-scroll-area" class="overflow-y-auto pr-1 space-y-3 mb-4 max-h-60">
                <p id="dialogue-text" class="text-stone-200 text-sm md:text-base leading-relaxed whitespace-pre-line">
                    Texto do diálogo...
                </p>
                <div id="typed-chat-history" class="space-y-2.5"></div>
            </div>

            <!-- Área de Digitação Livre -->
            <form id="typed-chat-form" onsubmit="window.submitTypedMessage(event)" class="hidden mb-4">
                <div class="flex gap-2">
                    <input
                        id="typed-chat-input"
                        type="text"
                        maxlength="240"
                        placeholder="Escreva seu argumento sobre união, salário, mais-valia ou revolta..."
                        class="flex-1 bg-stone-950 border border-stone-600 focus:border-amber-400 rounded-xl px-3.5 py-2.5 text-sm text-white placeholder-stone-500 outline-none"
                    />
                    <button
                        id="typed-chat-send"
                        type="submit"
                        class="px-4 py-2.5 bg-amber-600 hover:bg-amber-500 text-stone-950 font-extrabold rounded-xl text-sm transition cursor-pointer shrink-0"
                    >
                        Enviar
                    </button>
                </div>
            </form>

            <div id="dialogue-buttons" class="flex flex-wrap gap-2.5 justify-end pt-1 border-t border-stone-800/80">
                <button type="button" onclick="window.closeDialogue()" class="px-4 py-2 bg-stone-700 hover:bg-stone-600 text-white font-semibold rounded-lg text-sm transition cursor-pointer">
                    Continuar [ESC]
                </button>
            </div>
        </div>
    </div>

    <!-- Tela Inicial / Briefing Narrativo -->
    <div id="start-screen" class="absolute inset-0 bg-stone-950/95 flex items-center justify-center p-3 md:p-4 z-50 overflow-y-auto">
        <div class="max-w-2xl w-full bg-stone-900 border border-stone-700 rounded-2xl p-5 md:p-8 shadow-2xl text-center my-auto">
            <div class="inline-block px-3 py-1 bg-red-900/50 border border-red-500/40 rounded-full text-red-400 text-xs font-bold uppercase tracking-widest mb-2">
                Crítica Social &amp; Luta de Classes 3D
            </div>
            <h1 class="font-title text-2xl md:text-4xl font-bold text-white mb-3 tracking-tight">
                A ENGRENAGEM E A BANDEIRA
            </h1>
            <p class="text-stone-300 text-xs md:text-sm mb-4 leading-relaxed">
                Todos os moradores que você convencer pegam um <strong>cartaz de papelão</strong> e marcham para ficar parados protestando na frente da <strong>Prefeitura</strong>! Cada líder fabril (<strong>Ludismo</strong>, <strong>Trade Unions</strong> e <strong>Carta ao Povo</strong>) leva <strong>+25 trabalhadores</strong> com ele:
                <br><br>
                • <strong>Final 1 (Revolta Popular):</strong> Reúna os manifestantes exigidos e os 3 Livros de O Capital para derrubar o governo.<br>
                • <strong>Final 2 (Rendição do Governo — 15%):</strong> Mobilize as 3 fábricas e exija no Palácio que o governo desista de detê-lo.<br>
                • <strong>Final 3 (Eleição na Prefeitura):</strong> Suba no <strong>palanque da Prefeitura</strong> e dispute a contagem de votos!
            </p>

            <!-- Seletor de Nível de Dificuldade -->
            <div class="mb-4 text-left">
                <div class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2 text-center">
                    1. Escolha o Nível de Dificuldade:
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                    <button
                        type="button"
                        id="diff-btn-easy"
                        onclick="window.setDifficulty('easy')"
                        class="p-3 rounded-xl border-2 border-stone-700 bg-stone-800/60 hover:border-stone-500 text-left transition cursor-pointer"
                    >
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-emerald-400 text-sm">🟢 Fácil</span>
                            <span id="diff-check-easy" class="text-[10px] font-extrabold text-emerald-400 hidden">ATIVO</span>
                        </div>
                        <p class="text-[11px] text-stone-300 leading-snug"><strong>75 pessoas</strong> (as 3 fábricas já levam todas!) e <strong>75% de chance</strong> na eleição.</p>
                    </button>

                    <button
                        type="button"
                        id="diff-btn-medium"
                        onclick="window.setDifficulty('medium')"
                        class="p-3 rounded-xl border-2 border-amber-500 bg-amber-950/40 text-left transition cursor-pointer"
                    >
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-amber-400 text-sm">🟡 Média</span>
                            <span id="diff-check-medium" class="text-[10px] font-extrabold text-amber-400">ATIVO</span>
                        </div>
                        <p class="text-[11px] text-stone-300 leading-snug"><strong>100 pessoas</strong> (após as 3 fábricas ficam só 25) e <strong>50% de chance</strong> na eleição.</p>
                    </button>

                    <button
                        type="button"
                        id="diff-btn-hard"
                        onclick="window.setDifficulty('hard')"
                        class="p-3 rounded-xl border-2 border-stone-700 bg-stone-800/60 hover:border-stone-500 text-left transition cursor-pointer"
                    >
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-red-400 text-sm">🔴 Difícil</span>
                            <span id="diff-check-hard" class="text-[10px] font-extrabold text-red-400 hidden">ATIVO</span>
                        </div>
                        <p class="text-[11px] text-stone-300 leading-snug"><strong>200 pessoas</strong> (precisa da maioria: <strong>101</strong>), 50% de recusa e <strong>25% na eleição</strong>.</p>
                    </button>
                </div>
            </div>

            <!-- Escolha do Modo de Diálogo Antes de Iniciar -->
            <div class="mb-4 text-left">
                <div class="text-xs font-bold uppercase tracking-wider text-amber-400 mb-2 text-center">
                    2. Escolha o Modo de Conversa com os Personagens:
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5">
                    <button
                        type="button"
                        id="mode-btn-quick"
                        onclick="window.setDialogueMode('quick')"
                        class="p-3 rounded-xl border-2 border-red-500 bg-red-950/40 text-left transition cursor-pointer"
                    >
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-white text-sm">⚡ Diálogo Rápido</span>
                            <span id="mode-check-quick" class="text-xs font-extrabold text-red-400">ATIVO</span>
                        </div>
                        <p class="text-[11px] text-stone-300">Escolha o argumento certo nas opções de resposta para convencer os moradores.</p>
                    </button>

                    <button
                        type="button"
                        id="mode-btn-typed"
                        onclick="window.setDialogueMode('typed')"
                        class="p-3 rounded-xl border-2 border-stone-700 bg-stone-800/60 hover:border-stone-500 text-left transition cursor-pointer"
                    >
                        <div class="flex items-center justify-between mb-1">
                            <span class="font-bold text-white text-sm">⌨️ Conversar Digitando</span>
                            <span id="mode-check-typed" class="text-xs font-extrabold text-amber-400 hidden">ATIVO</span>
                        </div>
                        <p class="text-[11px] text-stone-300">Escreva livremente seus próprios argumentos para persuadir cada cidadão.</p>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-left bg-stone-800/70 p-3 rounded-xl mb-5 text-[11px] text-stone-300 border border-stone-700">
                <div><strong class="text-amber-400">PC:</strong> W, A, S, D para andar • Arraste o mouse para câmera.</div>
                <div><strong class="text-amber-400">Celular:</strong> Joystick na esquerda • Arraste na tela para câmera.</div>
                <div><strong class="text-amber-400">Interagir:</strong> Tecla <kbd class="bg-stone-700 px-1.5 py-0.5 rounded">E</kbd> ou botão <strong>Interagir</strong>.</div>
                <div><strong class="text-amber-400">Discursar:</strong> Tecla <kbd class="bg-stone-700 px-1.5 py-0.5 rounded">R</kbd> ou botão <strong>Discursar</strong>.</div>
            </div>

            <button type="button" id="btn-start-game" onclick="window.startGame()" class="w-full md:w-auto px-8 py-3.5 bg-gradient-to-r from-red-700 to-red-600 hover:from-red-600 hover:to-red-500 text-white font-extrabold rounded-xl text-base uppercase tracking-wider shadow-lg shadow-red-900/40 transition transform hover:scale-105 cursor-pointer">
                Entrar na Cidade
            </button>
        </div>
    </div>

    <!-- Tela de Vitória / 3 Finais -->
    <div id="victory-screen" class="hidden absolute inset-0 bg-red-950/95 flex items-center justify-center p-4 z-50">
        <div class="max-w-xl w-full bg-stone-900 border-2 border-amber-400 rounded-2xl p-8 shadow-2xl text-center">
            <div id="victory-icon" class="text-5xl mb-4">🚩💰⚒️</div>
            <span id="victory-badge" class="inline-block px-3 py-1 bg-amber-500/20 text-amber-300 text-xs font-bold uppercase tracking-widest rounded-full mb-2 border border-amber-500/40">
                FINAL CONCLUÍDO
            </span>
            <h2 id="victory-title" class="font-title text-2xl md:text-4xl font-bold text-amber-400 mb-3">
                O GOVERNO FOI DETIDO E A RIQUEZA DISTRIBUÍDA!
            </h2>
            <p id="victory-description" class="text-stone-200 text-sm md:text-base mb-6 leading-relaxed">
                Com o povo unido, o governo burguês caiu e todo o dinheiro acumulado nos cofres foi entregue diretamente aos moradores, inaugurando a <strong>República Socialista dos Trabalhadores</strong>.
            </p>
            <button type="button" onclick="location.reload()" class="px-6 py-3 bg-amber-500 hover:bg-amber-400 text-stone-950 font-extrabold rounded-xl uppercase tracking-wider transition cursor-pointer">
                Jogar Novamente
            </button>
        </div>
    </div>

    <!-- Tela de Derrota / Tempo Esgotado -->
    <div id="gameover-screen" class="hidden absolute inset-0 bg-stone-950/95 flex items-center justify-center p-4 z-50">
        <div class="max-w-xl w-full bg-stone-900 border-2 border-red-600 rounded-2xl p-8 shadow-2xl text-center">
            <div class="text-5xl mb-4">⏳⛓️</div>
            <h2 class="font-title text-3xl md:text-4xl font-bold text-red-500 mb-3">
                O DIA TERMINOU — REPRESSÃO!
            </h2>
            <p class="text-stone-200 text-sm md:text-base mb-6 leading-relaxed">
                As 24 horas se esgotaram antes que você conquistasse o poder na Prefeitura. As tropas da guarda burguesa dispersaram a cidade e restauraram o domínio do Capital.
            </p>
            <button type="button" onclick="location.reload()" class="px-6 py-3 bg-red-600 hover:bg-red-500 text-white font-extrabold rounded-xl uppercase tracking-wider transition cursor-pointer">
                Tentar Novamente
            </button>
        </div>
    </div>

    <!-- Controles Touch Completos para Celular / Tablet (Joystick Analógico + Botões de Ação) -->
    <div id="mobile-controls" class="lg:hidden fixed inset-x-0 bottom-0 pointer-events-none z-30 flex justify-between items-end p-4 pb-5 select-none">
        <!-- Joystick Analógico Virtual (Polegar Esquerdo) -->
        <div id="joystick-zone" class="pointer-events-auto relative w-28 h-28 md:w-32 md:h-32 rounded-full bg-stone-900/75 border-2 border-stone-600/80 backdrop-blur-sm flex items-center justify-center shadow-2xl touch-none">
            <div class="w-12 h-12 rounded-full border border-stone-500/40 pointer-events-none"></div>
            <div id="joystick-knob" class="absolute w-12 h-12 rounded-full bg-gradient-to-br from-red-500 to-red-700 border-2 border-amber-300 shadow-lg pointer-events-none transition-transform duration-75"></div>
            <span class="absolute -top-5 text-[10px] font-bold uppercase tracking-wider text-stone-300/80 pointer-events-none">Mover</span>
        </div>

        <!-- Botões de Ação Touch (Polegar Direito) -->
        <div class="pointer-events-auto flex flex-col items-end gap-2.5">
            <button
                type="button"
                id="mobile-btn-rally"
