        function createMultiStoryBuilding(x, z, w, d, floors, colorHex, brickTex, doorInfo = null) {
            const floorH = 3.2;
            const totalH = floors * floorH;
            const group = new THREE.Group();
            group.position.set(x, 0, z);

            const body = new THREE.Mesh(
                new THREE.BoxGeometry(w, totalH, d),
                new THREE.MeshStandardMaterial({ map: brickTex, color: colorHex, roughness: 0.88 })
            );
            body.position.y = totalH / 2;
            body.castShadow = true;
            body.receiveShadow = true;
            group.add(body);
            addCollider(x, z, w, d);

            const ledgeMat = new THREE.MeshStandardMaterial({ color: 0x27272a, roughness: 0.8 });
            const roof = new THREE.Mesh(new THREE.BoxGeometry(w + 0.5, 0.45, d + 0.5), ledgeMat);
            roof.position.y = totalH + 0.22;
            group.add(roof);

            const winLitMat = new THREE.MeshBasicMaterial({ color: 0xfde68a });
            const winDarkMat = new THREE.MeshStandardMaterial({ color: 0x18181b, roughness: 0.4 });
            for (let f = 0; f < floors; f++) {
                const wy = f * floorH + 1.8;
                const cols = Math.max(2, Math.floor(w / 3.2));
                for (let c = 0; c < cols; c++) {
                    const wx = -w / 2 + (w / (cols + 1)) * (c + 1);
                    const isLit = ((f + c + Math.abs(Math.round(x))) % 3 !== 0);
                    const wMat = isLit ? winLitMat : winDarkMat;

                    const winFront = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 1.5), wMat);
                    winFront.position.set(wx, wy, d / 2 + 0.03);
                    group.add(winFront);

                    const winBack = new THREE.Mesh(new THREE.PlaneGeometry(1.1, 1.5), wMat);
                    winBack.position.set(wx, wy, -d / 2 - 0.03);
                    winBack.rotation.y = Math.PI;
                    group.add(winBack);
                }
            }

            const doorMat = new THREE.MeshStandardMaterial({ color: doorInfo ? 0xb45309 : 0x292524, roughness: 0.6 });
            if (doorInfo && doorInfo.doorSide === 'east') {
                const door = new THREE.Mesh(new THREE.BoxGeometry(0.25, 2.5, 1.5), doorMat);
                door.position.set(w / 2 + 0.05, 1.25, 0);
                group.add(door);
                addDoorTrigger(x + w / 2 + 1.3, z, doorInfo.label, doorInfo.type, doorInfo.pos);
            } else {
                const door = new THREE.Mesh(new THREE.BoxGeometry(1.5, 2.5, 0.25), doorMat);
                door.position.set(0, 1.25, d / 2 + 0.05);
                group.add(door);
                if (doorInfo) {
                    addDoorTrigger(x, z + d / 2 + 1.3, doorInfo.label, doorInfo.type, doorInfo.pos);
                }
            }

            scene.add(group);
        }

        function createClockTower(x, z) {
            const towerGroup = new THREE.Group();
            towerGroup.position.set(x, 0, z);

            const stoneMat = new THREE.MeshStandardMaterial({ color: 0x52525b, roughness: 0.85 });
            const roofMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, metalness: 0.6, roughness: 0.4 });
            const clockFaceMat = new THREE.MeshBasicMaterial({ color: 0xfef3c7 });
            const handMat = new THREE.MeshBasicMaterial({ color: 0x111111 });

            const base = new THREE.Mesh(new THREE.BoxGeometry(4.4, 15, 4.4), stoneMat);
            base.position.y = 7.5;
            base.castShadow = true;
            towerGroup.add(base);
            addCollider(x, z, 4.4, 4.4);

            const spire = new THREE.Mesh(new THREE.ConeGeometry(3.4, 5.5, 4), roofMat);
            spire.position.y = 17.75;
            spire.rotation.y = Math.PI / 4;
            towerGroup.add(spire);

            [
                { pos: [0, 12.2, 2.25], rotY: 0 },
                { pos: [0, 12.2, -2.25], rotY: Math.PI },
                { pos: [2.25, 12.2, 0], rotY: Math.PI / 2 },
                { pos: [-2.25, 12.2, 0], rotY: -Math.PI / 2 }
            ].forEach(cf => {
                const face = new THREE.Mesh(new THREE.CircleGeometry(1.35, 20), clockFaceMat);
                face.position.set(...cf.pos);
                face.rotation.y = cf.rotY;
                towerGroup.add(face);

                const hand = new THREE.Mesh(new THREE.BoxGeometry(0.1, 0.95, 0.05), handMat);
                hand.position.set(cf.pos[0] * 1.01, cf.pos[1] + 0.25, cf.pos[2] * 1.01);
                hand.rotation.y = cf.rotY;
                towerGroup.add(hand);
            });

            scene.add(towerGroup);
        }

