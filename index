        function addDoorTrigger(x, z, label, interiorId, spawnPos) {
            const pad = new THREE.Mesh(
                new THREE.CylinderGeometry(1.15, 1.15, 0.08, 18),
                new THREE.MeshBasicMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.55 })
