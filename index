        function buildRailway(x, zStart, zEnd) {
            const railMat = new THREE.MeshStandardMaterial({ color: 0x71717a, metalness: 0.85, roughness: 0.3 });
            const tieMat = new THREE.MeshStandardMaterial({ color: 0x3f2e21, roughness: 0.9 });

            [-0.8, 0.8].forEach(offset => {
                const rail = new THREE.Mesh(new THREE.BoxGeometry(0.14, 0.16, zEnd - zStart), railMat);
                rail.position.set(x + offset, 0.14, (zStart + zEnd) / 2);
                scene.add(rail);
            });

            for (let z = zStart; z <= zEnd; z += 1.6) {
                const tie = new THREE.Mesh(new THREE.BoxGeometry(2.6, 0.1, 0.35), tieMat);
                tie.position.set(x, 0.05, z);
                scene.add(tie);
            }
        }

