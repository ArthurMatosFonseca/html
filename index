        // --- CONSTRUÇÃO DO MUNDO ABERT0 ---
        function buildWorld() {
            const cobbleTex = createProceduralTexture('#2d3138', '#1c1f24', 'cobble');
            cobbleTex.repeat.set(42, 42);

            const brickFactoryTex = createProceduralTexture('#5c2b23', '#2e1511', 'bricks');
            brickFactoryTex.repeat.set(4, 3);

            const brickTenementTex = createProceduralTexture('#4a4e54', '#2b2d30', 'bricks');
            brickTenementTex.repeat.set(3, 2);

            const marbleTex = createProceduralTexture('#e5e7eb', '#cbd5e1', 'marble');

            // 1. Chão Principal
            const ground = new THREE.Mesh(
                new THREE.PlaneGeometry(280, 280),
                new THREE.MeshStandardMaterial({ map: cobbleTex, roughness: 0.9 })
            );
