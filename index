                const btn = document.createElement('button');
                btn.type = 'button';
                btn.innerText = b.text;
                btn.className = b.className || "px-4 py-2 bg-red-600 hover:bg-red-500 text-white font-bold rounded-lg text-xs md:text-sm transition shadow-lg cursor-pointer";
