            // Estradas principais e avenidas
            const roadMat = new THREE.MeshStandardMaterial({ color: 0x1a1c20, roughness: 0.95 });
            const roadNS = new THREE.Mesh(new THREE.PlaneGeometry(12, 240), roadMat);
            roadNS.rotation.x = -Math.PI / 2;
            roadNS.position.y = 0.02;
            scene.add(roadNS);

            const roadEW = new THREE.Mesh(new THREE.PlaneGeometry(240, 12), roadMat);
            roadEW.rotation.x = -Math.PI / 2;
            roadEW.position.y = 0.02;
            scene.add(roadEW);

            const roadTenement = new THREE.Mesh(new THREE.PlaneGeometry(130, 8), roadMat);
            roadTenement.rotation.x = -Math.PI / 2;
            roadTenement.position.set(-28, 0.02, 42);
            scene.add(roadTenement);

            const roadSouth = new THREE.Mesh(new THREE.PlaneGeometry(150, 8), roadMat);
            roadSouth.rotation.x = -Math.PI / 2;
            roadSouth.position.set(-20, 0.02, 72);
            scene.add(roadSouth);

            const roadWest = new THREE.Mesh(new THREE.PlaneGeometry(8, 120), roadMat);
            roadWest.rotation.x = -Math.PI / 2;
            roadWest.position.set(-65, 0.02, 10);
            scene.add(roadWest);

