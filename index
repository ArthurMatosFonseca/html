            document.getElementById('cutscene-overlay').classList.add('hidden');
            document.getElementById('victory-screen').classList.remove('hidden');
        };

        // --- CONTROLES & CÂMERA (DESKTOP + MOBILE MULTI-TOUCH JOYSTICK) ---
        function setupControls() {
            window.addEventListener('keydown', (e) => {
                if (gameState.dialogueOpen) {
                    if (e.key === 'Escape') window.closeDialogue();
                    return;
                }
                if (e.key in keys) keys[e.key] = true;
                if (e.key.toLowerCase() in keys) keys[e.key.toLowerCase()] = true;
                if (e.key.toLowerCase() === 'e') window.triggerInteraction();
                if (e.key.toLowerCase() === 'r') window.rallyNearbyCitizens();
            });

            window.addEventListener('keyup', (e) => {
                if (e.key in keys) keys[e.key] = false;
                if (e.key.toLowerCase() in keys) keys[e.key.toLowerCase()] = false;
            });

            const canvas = document.getElementById('game-canvas');
            canvas.addEventListener('mousedown', (e) => { isDragging = true; prevMouseX = e.clientX; prevMouseY = e.clientY; });
            window.addEventListener('mouseup', () => isDragging = false);
            window.addEventListener('mousemove', (e) => {
                if (!isDragging || !gameState.started) return;
                cameraAngle -= (e.clientX - prevMouseX) * 0.007;
                cameraPitch = Math.max(0.16, Math.min(1.15, cameraPitch + (e.clientY - prevMouseY) * 0.005));
                prevMouseX = e.clientX;
                prevMouseY = e.clientY;
            });

            // Controle de Câmera Multi-Touch Mobile
            canvas.addEventListener('touchstart', (e) => {
                if (!gameState.started || gameState.dialogueOpen) return;
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const t = e.changedTouches[i];
                    if (!cameraTouchState.active && t.identifier !== joystickState.touchId) {
                        cameraTouchState.active = true;
                        cameraTouchState.touchId = t.identifier;
                        cameraTouchState.prevX = t.clientX;
                        cameraTouchState.prevY = t.clientY;
                    }
                }
            }, { passive: true });

            canvas.addEventListener('touchmove', (e) => {
                if (!gameState.started || !cameraTouchState.active) return;
                for (let i = 0; i < e.changedTouches.length; i++) {
                    const t = e.changedTouches[i];
                    if (t.identifier === cameraTouchState.touchId) {
                        const dx = t.clientX - cameraTouchState.prevX;
                        const dy = t.clientY - cameraTouchState.prevY;
                        cameraAngle -= dx * 0.0085;
                        cameraPitch = Math.max(0.16, Math.min(1.15, cameraPitch + dy * 0.006));
                        cameraTouchState.prevX = t.clientX;
                        cameraTouchState.prevY = t.clientY;
                    }
                }
            }, { passive: true });

            const releaseCameraTouch = (e) => {
                for (let i = 0; i < e.changedTouches.length; i++) {
                    if (e.changedTouches[i].identifier === cameraTouchState.touchId) {
                        cameraTouchState.active = false;
                        cameraTouchState.touchId = null;
                    }
                }
            };
            canvas.addEventListener('touchend', releaseCameraTouch, { passive: true });
            canvas.addEventListener('touchcancel', releaseCameraTouch, { passive: true });

            // Joystick Virtual Analógico Mobile
            const joyZone = document.getElementById('joystick-zone');
            const joyKnob = document.getElementById('joystick-knob');
            if (joyZone && joyKnob) {
                const maxRadius = 38;

                const updateJoystickFromTouch = (touch) => {
                    const rect = joyZone.getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + rect.height / 2;
                    let dx = touch.clientX - centerX;
                    let dy = touch.clientY - centerY;
                    const dist = Math.hypot(dx, dy);
                    if (dist > maxRadius) {
                        dx = (dx / dist) * maxRadius;
                        dy = (dy / dist) * maxRadius;
                    }
                    joyKnob.style.transform = `translate(${dx}px, ${dy}px)`;
                    joystickState.x = dx / maxRadius;
                    joystickState.y = dy / maxRadius;
                };

                const resetJoystick = () => {
                    joystickState.active = false;
                    joystickState.touchId = null;
                    joystickState.x = 0;
                    joystickState.y = 0;
                    joyKnob.style.transform = `translate(0px, 0px)`;
                };

                joyZone.addEventListener('touchstart', (e) => {
                    e.preventDefault();
                    if (joystickState.active) return;
                    const t = e.changedTouches[0];
                    joystickState.active = true;
                    joystickState.touchId = t.identifier;
                    updateJoystickFromTouch(t);
                }, { passive: false });

                joyZone.addEventListener('touchmove', (e) => {
                    e.preventDefault();
                    if (!joystickState.active) return;
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        if (e.changedTouches[i].identifier === joystickState.touchId) {
                            updateJoystickFromTouch(e.changedTouches[i]);
                        }
                    }
                }, { passive: false });

                joyZone.addEventListener('touchend', (e) => {
                    for (let i = 0; i < e.changedTouches.length; i++) {
                        if (e.changedTouches[i].identifier === joystickState.touchId) {
                            resetJoystick();
                        }
                    }
                }, { passive: true });

                joyZone.addEventListener('touchcancel', resetJoystick, { passive: true });
            }
        }

        function addCollider(x, z, w, d) {
            colliders.push({
                minX: x - w / 2 - 0.6,
                maxX: x + w / 2 + 0.6,
                minZ: z - d / 2 - 0.6,
                maxZ: z + d / 2 + 0.6
            });
        }

        function checkCitizenCollision(nx, nz) {
            if (Math.abs(nx) > 122 || Math.abs(nz) > 122) return true;
            for (let i = 0; i < colliders.length; i++) {
                const c = colliders[i];
                if (nx > c.minX - 0.25 && nx < c.maxX + 0.25 && nz > c.minZ - 0.25 && nz < c.maxZ + 0.25) {
                    return true;
                }
            }
            return false;
        }

        function checkCollision(nx, nz) {
            if (currentInterior && interiorBounds[currentInterior]) {
                const b = interiorBounds[currentInterior];
                const pad = 0.85;
                if (nx < b.minX + pad || nx > b.maxX - pad || nz < b.minZ + pad || nz > b.maxZ - pad) {
                    return true;
                }
                for (let ic of interiorColliders) {
                    if (nx > ic.minX && nx < ic.maxX && nz > ic.minZ && nz < ic.maxZ) return true;
                }
                return false;
            }

            if (Math.abs(nx) > 125 || Math.abs(nz) > 125) return true;
            for (let c of colliders) {
                if (nx > c.minX && nx < c.maxX && nz > c.minZ && nz < c.maxZ) return true;
            }
            return false;
        }

        function updateZoneIndicator(x, z) {
            const zoneEl = document.getElementById('zone-name');
            if (!zoneEl) return;
            if (currentInterior) {
                const names = {
                    tenement: "Interior: Cortiço Operário",
                    tenement_crowded: "Interior: Cortiço Superlotado",
                    socialist_hq: "Interior: Gráfica Socialista",
                    mansion: "Interior: Mansão Burguesa",
                    tavern: "Interior: Taverna da Engrenagem",
                    factory_luddism: "Interior: Fábrica Albion (Ludismo)",
                    factory_unions: "Interior: Metalúrgica Vulcano (Trade Unions)",
                    factory_charter: "Interior: Manufatura Imperial (Carta ao Povo)"
                };
                zoneEl.innerText = names[currentInterior] || "Interior";
                return;
            }
            if (z < -56) zoneEl.innerText = "Prefeitura & Colina Dourada";
            else if (x > 28) zoneEl.innerText = "Polo Industrial Leste";
            else if (x < -42 && Math.abs(z) < 22) zoneEl.innerText = "Beco Vermelho (Socialistas)";
            else if (z > 25) zoneEl.innerText = "Cortiços Operários";
            else zoneEl.innerText = "Praça Central & Acampamentos";
        }

        // --- MINIMAPA EM TEMPO REAL ---
        function updateMinimap() {
            const canvas = document.getElementById('minimap-canvas');
            if (!canvas || !playerGroup) return;
            const ctx = canvas.getContext('2d');
            const w = canvas.width;
            const h = canvas.height;
            const scale = w / 250;

            const toMapX = (wx) => w / 2 + wx * scale;
            const toMapY = (wz) => h / 2 + wz * scale;

            ctx.fillStyle = '#0c0a09';
            ctx.fillRect(0, 0, w, h);

            ctx.fillStyle = '#292524';
            ctx.fillRect(toMapX(-6), toMapY(-120), 12 * scale, 240 * scale);
            ctx.fillRect(toMapX(-120), toMapY(-6), 240 * scale, 12 * scale);

            // Prefeitura / Palácio do Governo (Norte)
            ctx.fillStyle = '#fbbf24';
            ctx.fillRect(toMapX(-14), toMapY(-102), 28 * scale, 18 * scale);

            // Palanque Eleitoral na Prefeitura
            ctx.fillStyle = '#38bdf8';
            ctx.fillRect(toMapX(-11.3), toMapY(-78.4), 6 * scale, 4.5 * scale);

            // QG Socialista (Oeste)
            ctx.fillStyle = '#ef4444';
            ctx.fillRect(toMapX(-68), toMapY(-7), 12 * scale, 14 * scale);

            // 3 Fábricas (Leste)
            ctx.fillStyle = gameState.factories.luddism.resolved ? '#22c55e' : '#f97316';
            ctx.fillRect(toMapX(43), toMapY(24), 18 * scale, 22 * scale);
            ctx.fillStyle = gameState.factories.unions.resolved ? '#22c55e' : '#f97316';
            ctx.fillRect(toMapX(45), toMapY(-16), 18 * scale, 22 * scale);
            ctx.fillStyle = gameState.factories.charter.resolved ? '#22c55e' : '#f97316';
            ctx.fillRect(toMapX(43), toMapY(-56), 18 * scale, 22 * scale);

            // Os 3 Livros de O Capital
            ctx.fillStyle = '#f43f5e';
            capitalBooksList.forEach(m => {
                if (!m.collected) {
                    ctx.beginPath();
                    ctx.arc(toMapX(m.x), toMapY(m.z), 3.3, 0, Math.PI * 2);
                    ctx.fill();
                }
            });

            // Moradores (Amarelo = Na Cidade, Verde = Protestando na Prefeitura)
            allCitizens.forEach(c => {
                ctx.fillStyle = c.convinced ? '#34d399' : '#fde047';
                ctx.fillRect(toMapX(c.group.position.x) - 1, toMapY(c.group.position.z) - 1, 2.2, 2.2);
            });

            // Jogador (Seta Azul)
            const refPos = currentInterior ? savedOutdoorPos : playerGroup.position;
            const px = toMapX(refPos.x);
            const pz = toMapY(refPos.z);

            ctx.save();
            ctx.translate(px, pz);
            ctx.rotate(-cameraAngle);
            ctx.fillStyle = '#38bdf8';
            ctx.beginPath();
            ctx.moveTo(0, -5);
            ctx.lineTo(4, 4);
            ctx.lineTo(0, 2);
            ctx.lineTo(-4, 4);
            ctx.closePath();
            ctx.fill();
            ctx.restore();
        }

        // --- LOOP DE ANIMAÇÃO ---
        function animate() {
            requestAnimationFrame(animate);
            const delta = Math.min(clock.getDelta(), 0.1);
            const time = clock.getElapsedTime();

            if (gameState.cutsceneActive) {
                updateCutscene(delta, time);
                renderer.render(scene, camera);
                return;
            }

            updateClock(delta);

            if (gameState.started && !gameState.dialogueOpen && !gameState.gameOver && playerGroup) {
                const speed = 13.5 * delta;
                let moveForward = 0;
                let moveRight = 0;

                if (keys.w || keys.ArrowUp) moveForward += 1;
                if (keys.s || keys.ArrowDown) moveForward -= 1;
                if (keys.a || keys.ArrowLeft) moveRight -= 1;
                if (keys.d || keys.ArrowRight) moveRight += 1;

                if (joystickState.active && (Math.abs(joystickState.x) > 0.12 || Math.abs(joystickState.y) > 0.12)) {
                    moveRight += joystickState.x;
                    moveForward -= joystickState.y;
                }

                if (Math.abs(moveForward) > 0.05 || Math.abs(moveRight) > 0.05) {
                    const forwardVec = new THREE.Vector3(-Math.sin(cameraAngle), 0, -Math.cos(cameraAngle));
                    const rightVec = new THREE.Vector3(Math.cos(cameraAngle), 0, -Math.sin(cameraAngle));
                    const moveVec = new THREE.Vector3()
                        .addScaledVector(forwardVec, moveForward)
                        .addScaledVector(rightVec, moveRight);

                    const inputMag = Math.min(1, moveVec.length());
                    moveVec.normalize();

                    const nextX = playerGroup.position.x + moveVec.x * speed * inputMag;
                    const nextZ = playerGroup.position.z + moveVec.z * speed * inputMag;

                    if (!checkCollision(nextX, playerGroup.position.z)) playerGroup.position.x = nextX;
                    if (!checkCollision(playerGroup.position.x, nextZ)) playerGroup.position.z = nextZ;

                    playerGroup.rotation.y = Math.atan2(moveVec.x, moveVec.z);

                    const swing = Math.sin(time * 12) * 0.55 * inputMag;
                    leftLeg.rotation.x = swing;
                    rightLeg.rotation.x = -swing;
                    leftArm.rotation.x = -swing * 0.8;
                    rightArm.rotation.x = swing * 0.8;

                    updateZoneIndicator(playerGroup.position.x, playerGroup.position.z);
                } else {
                    leftLeg.rotation.x = 0;
                    rightLeg.rotation.x = 0;
                    leftArm.rotation.x = 0;
                    rightArm.rotation.x = 0;
                }
            }

            // Câmera Orbital em Terceira Pessoa (com colisão inteligente dentro das fábricas e interiores)
            if (playerGroup && camera) {
                const targetX = playerGroup.position.x;
                const targetY = playerGroup.position.y + 1.65;
                const targetZ = playerGroup.position.z;

                const isFactoryInterior = currentInterior && currentInterior.startsWith('factory_');
                let camDist = currentInterior ? (isFactoryInterior ? 6.8 : 5.4) : 11.5;

                if (currentInterior && interiorBounds[currentInterior]) {
                    const b = interiorBounds[currentInterior];
                    const wallMargin = 0.75;
                    const dirX = Math.sin(cameraAngle) * Math.cos(cameraPitch);
                    const dirY = Math.sin(cameraPitch);
                    const dirZ = Math.cos(cameraAngle) * Math.cos(cameraPitch);

                    if (dirX > 0.001) camDist = Math.min(camDist, (b.maxX - wallMargin - targetX) / dirX);
                    if (dirX < -0.001) camDist = Math.min(camDist, (b.minX + wallMargin - targetX) / dirX);
                    if (dirZ > 0.001) camDist = Math.min(camDist, (b.maxZ - wallMargin - targetZ) / dirZ);
                    if (dirZ < -0.001) camDist = Math.min(camDist, (b.minZ + wallMargin - targetZ) / dirZ);
                    if (dirY > 0.001) camDist = Math.min(camDist, (b.height - 0.65 - targetY) / dirY);

                    camDist = Math.max(1.8, camDist);
                }

                const camX = targetX + Math.sin(cameraAngle) * Math.cos(cameraPitch) * camDist;
                const camY = targetY + Math.sin(cameraPitch) * camDist;
                const camZ = targetZ + Math.cos(cameraAngle) * Math.cos(cameraPitch) * camDist;
                camera.position.set(camX, camY, camZ);
                camera.lookAt(targetX, targetY, targetZ);
            }

            // Animações Ambientais
            if (!currentInterior) {
                smokeMeshes.forEach(p => {
                    const cycle = (time * 1.4 + p.userData.offset) % 8;
                    p.position.y = p.userData.baseY + cycle * 2.2;
                    p.position.x = p.userData.baseX + Math.sin(time + cycle) * 1.4;
                    p.scale.setScalar(1 + cycle * 0.25);
                });

                gears.forEach(g => {
                    if (!g.userData.stopped) {
                        g.rotation.x += delta * 1.8;
                    }
                });

                fireFlickers.forEach(f => {
                    const flick = 0.85 + Math.sin(time * 14 + f.phase) * 0.25;
                    f.light.intensity = 1.4 * flick;
                    f.mesh.scale.setScalar(flick);
                });

                capitalBooksList.forEach(m => {
                    if (!m.collected) {
                        m.mesh.rotation.y += delta * 1.5;
                        m.mesh.position.y = 1.2 + Math.sin(time * 2.5 + m.x) * 0.15;
                    }
                });
            }

            animatedNPCs.forEach(npc => {
                if (npc.pose === 'standing') {
                    npc.group.position.y = Math.sin(time * 2.5 + npc.phase) * 0.04;
                }
            });

            // Animação da Multidão Caminhando Pelas Ruas (com colisão contra casas e blocos)
            if (!currentInterior) {
                walkingCitizens.forEach(c => {
                    if (c.citizen && c.citizen.convinced) return;

                    if (c.paused || gameState.dialogueOpen) {
                        c.rig.leftLeg.rotation.x = 0;
                        c.rig.rightLeg.rotation.x = 0;
                        c.rig.leftArm.rotation.x = 0;
                        c.rig.rightArm.rotation.x = 0;
                        if (playerGroup) {
                            c.rig.group.rotation.y = Math.atan2(
                                playerGroup.position.x - c.rig.group.position.x,
                                playerGroup.position.z - c.rig.group.position.z
                            );
                        }
                        return;
                    }

                    const target = c.waypoints[c.currentTarget];
                    const dx = target.x - c.rig.group.position.x;
                    const dz = target.z - c.rig.group.position.z;
                    const dist = Math.hypot(dx, dz);

                    if (dist < 0.9) {
                        c.currentTarget = (c.currentTarget + 1) % c.waypoints.length;
                        c.stuckTimer = 0;
                    } else {
                        const step = c.speed * delta;
                        const vx = (dx / dist) * step;
                        const vz = (dz / dist) * step;
                        const curX = c.rig.group.position.x;
                        const curZ = c.rig.group.position.z;

                        let moved = false;
                        if (!checkCitizenCollision(curX + vx, curZ + vz)) {
                            c.rig.group.position.x = curX + vx;
                            c.rig.group.position.z = curZ + vz;
                            c.rig.group.rotation.y = Math.atan2(vx, vz);
                            moved = true;
                        } else {
                            const sideSign = (c.walkPhase % 2 > 1) ? 1 : -1;
                            const altX = curX + (-vz) * sideSign;
                            const altZ = curZ + (vx) * sideSign;

                            if (!checkCitizenCollision(curX + vx, curZ) && Math.abs(vx) > 0.001) {
                                c.rig.group.position.x = curX + vx;
                                c.rig.group.rotation.y = Math.atan2(vx, 0);
                                moved = true;
                            } else if (!checkCitizenCollision(curX, curZ + vz) && Math.abs(vz) > 0.001) {
                                c.rig.group.position.z = curZ + vz;
                                c.rig.group.rotation.y = Math.atan2(0, vz);
                                moved = true;
                            } else if (!checkCitizenCollision(altX, altZ)) {
                                c.rig.group.position.x = altX;
                                c.rig.group.position.z = altZ;
                                c.rig.group.rotation.y = Math.atan2(altX - curX, altZ - curZ);
                                moved = true;
                            }
                        }

                        if (!moved) {
                            c.stuckTimer = (c.stuckTimer || 0) + delta;
                            if (c.stuckTimer > 0.6) {
                                c.currentTarget = (c.currentTarget + 1) % c.waypoints.length;
                                c.stuckTimer = 0;
                            }
                        } else {
                            c.stuckTimer = 0;
                        }

                        if (moved && playerGroup && c.rig.group.position.distanceToSquared(playerGroup.position) < 4200) {
                            const swing = Math.sin(time * 9 + c.walkPhase) * 0.45;
                            c.rig.leftLeg.rotation.x = swing;
                            c.rig.rightLeg.rotation.x = -swing;
                            c.rig.leftArm.rotation.x = -swing * 0.7;
                            c.rig.rightArm.rotation.x = swing * 0.7;
                        }
                    }
                });
            }

            // Anima o certinho 3D (✓) e os cartazes de papelão na frente da Prefeitura
            allCitizens.forEach(c => {
                if (c.convinced) {
                    if (c.rig.convincedMarker) {
                        c.rig.convincedMarker.rotation.y = time * 2.4;
                        c.rig.convincedMarker.position.y = 3.25 + Math.sin(time * 3.5 + (c.protestPhase || 0)) * 0.08;
                    }
                    if (c.rig.rightArm && c.rig.hasCardboardSign) {
                        c.rig.rightArm.rotation.x = -2.35 + Math.sin(time * 5.2 + (c.protestPhase || 0)) * 0.18;
                        c.rig.group.position.y = Math.abs(Math.sin(time * 4.5 + (c.protestPhase || 0))) * 0.09;
                    }
                }
            });

            // Detecção de Proximidade para Interação (Desktop e Botão Touch Mobile)
            if (gameState.started && !gameState.dialogueOpen && !gameState.gameOver && playerGroup) {
                let nearest = null;
                let minDist = Infinity;

                interactables.forEach(item => {
                    const dist = playerGroup.position.distanceTo(item.mesh.position);
                    if (dist < item.radius && dist < minDist) {
                        minDist = dist;
                        nearest = item;
                    }
                });

                activeInteractable = nearest;
                const promptEl = document.getElementById('interact-prompt');
                const mobBtn = document.getElementById('mobile-btn-interact');
                const mobLbl = document.getElementById('mobile-interact-label');

                if (nearest) {
                    const lbl = typeof nearest.label === 'function' ? nearest.label() : nearest.label;
                    promptEl.innerText = `[E] ${lbl}`;
                    promptEl.classList.remove('hidden');

                    if (mobBtn && mobLbl) {
                        mobBtn.className = "px-5 py-4 rounded-2xl bg-red-600 active:bg-red-500 text-white font-extrabold text-xs md:text-sm shadow-2xl border-2 border-amber-300 flex items-center gap-2 scale-105 transition cursor-pointer";
                        mobLbl.innerText = lbl.length > 22 ? lbl.slice(0, 22) + '…' : lbl;
                    }
                } else {
                    promptEl.classList.add('hidden');
                    if (mobBtn && mobLbl) {
                        mobBtn.className = "px-5 py-4 rounded-2xl bg-stone-800/85 text-stone-400 font-extrabold text-xs md:text-sm shadow-xl border-2 border-stone-700 flex items-center gap-2 transition cursor-pointer opacity-80";
                        mobLbl.innerText = "Interagir";
                    }
                }
            }

            minimapTimer += delta;
            if (minimapTimer >= 0.14) {
                minimapTimer = 0;
                updateMinimap();
            }

            renderer.render(scene, camera);
        }

        window.onload = function () {
            init();
        };
    </script>
