        window.submitTypedMessage = function(event) {
            event.preventDefault();
            if (!gameState.currentSpeaker) return;

            const inputEl = document.getElementById('typed-chat-input');
            const userText = inputEl.value.trim();
            if (!userText) return;

            const historyEl = document.getElementById('typed-chat-history');
            const scrollArea = document.getElementById('dialogue-scroll-area');
            const speaker = gameState.currentSpeaker;

            const userBubble = document.createElement('div');
            userBubble.className = 'bg-red-950/70 border border-red-700/60 rounded-lg p-2.5 text-xs md:text-sm text-stone-100 ml-6';
            userBubble.innerHTML = `<strong class="text-red-400 block text-[11px] uppercase mb-0.5">Você (Operário):</strong>${userText.replace(/</g, '&lt;')}`;
            historyEl.appendChild(userBubble);

            gameState.chatHistory.push({ role: 'user', text: userText });
            inputEl.value = '';

            const persuasiveWords = ['união', 'unir', 'juntos', 'direito', 'salário', 'exploração', 'mais-valia', 'riqueza', 'povo', 'greve', 'revolta', 'justiça', 'trabalhador', 'fábrica', 'governo', 'dignidade', 'capital', 'patrão'];
            const lowerMsg = userText.toLowerCase();
            const isPersuasive = userText.length >= 8 && (persuasiveWords.some(w => lowerMsg.includes(w)) || gameState.chatHistory.length >= 2);

            let reply = "";
            if (speaker.role.includes("Burgues") || speaker.role.includes("Estado") || speaker.role.includes("Proprietário") || speaker.role.includes("Acionista")) {
                reply = "Hmpf! Palavras inflamadas não mudam as leis da propriedade privada. A guarda real protege a ordem desta cidade!";
            } else if (isPersuasive) {
                reply = "Você fala com clareza e verdade! Nós produzimos toda a riqueza desta cidade e merecemos dignidade e voz.";
            } else {
                reply = "Ainda tenho receio das consequências... Me explique melhor como a união dos trabalhadores pode mudar nossas vidas!";
            }

            const replyBubble = document.createElement('div');
            replyBubble.className = 'bg-stone-800 border border-stone-700 rounded-lg p-2.5 text-xs md:text-sm text-stone-200 mr-6';
            replyBubble.innerHTML = `<strong class="text-amber-400 block text-[11px] uppercase mb-0.5">${speaker.name}:</strong>${reply}`;
            historyEl.appendChild(replyBubble);

            if (gameState.currentCitizenTarget && !gameState.currentCitizenTarget.convinced) {
                const c = gameState.currentCitizenTarget;
                if (isPersuasive) {
                    if (gameState.refusalChance > 0 && Math.random() < gameState.refusalChance) {
                        const refuseNotice = document.createElement('div');
                        refuseNotice.className = 'bg-red-950/90 border border-red-500 rounded-lg p-2.5 text-xs text-red-200 font-semibold';
                        refuseNotice.innerText = `😟 ${c.name} ouviu seu argumento, mas ficou com medo da repressão e recusou se juntar agora (50% de chance no modo Difícil).`;
